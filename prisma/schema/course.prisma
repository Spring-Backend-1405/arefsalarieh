enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  draft
  published
  archived
}

model CourseCategory {
  id           Int             @id @default(autoincrement())
  categoryName String
  parentId     Int?
  parent       CourseCategory? @relation("CategoryRelations", fields: [parentId], references: [id])

  children CourseCategory[] @relation("CategoryRelations")

  courseCategoryLists CourseCategoryList[]
}

model CourseType {
  id       Int      @id @default(autoincrement())
  typeName String
  courses  Course[]
}

model Course {
  id               String       @id @default(uuid())
  title            String
  shortDescription String
  isFree           Boolean      @default(false)
  level            CourseLevel
  status           CourseStatus @default(draft)
  teacherId        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  typeId           Int

  teacher             User                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseType          CourseType           @relation(fields: [typeId], references: [id], onDelete: Cascade)
  courseCategoryLists CourseCategoryList[]
  detail              CourseDetail?
  coursePrices        CoursePrice[]
  courseLikes         CourseLike[]
  courseDisLikes      CourseDisLike[]
  comments            CourseComment[]
  courseReserves      CourseReserves[]
  courseEnrolls       CourseEnroll[]
  courseInvoices      CourseInvoice[]
  files               CourseVideo[]
}

model CourseDetail {
  id                   String   @id @default(uuid())
  courseId             String   @unique
  fullDescription      String
  language             String   @default("fa")
  certificateAvailable Boolean  @default(false)
  demoVideoUrl         String?
  totalStudent         Int      @default(0)
  capacity             Int
  slug                 String?  @unique
  duration             String?
  lastUpdated          DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseCategoryList {
  courseId   String
  categoryId Int

  assignedAt DateTime @default(now())

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courseId, categoryId])
}

model CoursePrice {
  id            String    @id @default(uuid())
  courseId      String
  price         Int
  discountPrice Int?
  startAt       DateTime?
  endAt         DateTime?
  isActive      Boolean   @default(false)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseLike {
  courseId String
  userId   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
}

model CourseDisLike {
  courseId String
  userId   String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
}

model CourseComment {
  id        String  @id @default(uuid())
  text      String
  isConfirm Boolean @default(false)
  isReject  Boolean @default(false)
  isDelete  Boolean @default(false)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   CourseComment?  @relation("CommentParent", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CourseComment[] @relation("CommentParent")

  createdAt DateTime @default(now())
}

model CourseVideo {
  id            String   @id @default(uuid())
  filename      String
  originalName  String
  mimeType      String
  extension     String
  size          Int
  path          String
  url           String
  sessionNumber Int
  createdAt     DateTime @default(now())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])
}
